# Injected by AIWA into the preview VM. You do not set these by hand.
# The project's real Neon Postgres (when the app stores data); absent -> in-VM PGlite.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/mydb
# The app's Neon Auth URL (when the app has accounts). Client reads VITE_; server verifies JWTs via the
# JWKS under NEON_AUTH_BASE_URL. Same value for both.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# Resend (when the owner connects it under Connectors > Resend). RESEND_FROM is the address EVERY email
# is sent from; RESEND_NOTIFY_TO is where form submissions and owner notifications go. Neither is set
# by hand: the platform injects them, and server/lib/email.ts reads them at send time.
RESEND_API_KEY=re_xxx
RESEND_FROM=hello@yourdomain.com
RESEND_NOTIFY_TO=you@yourbusiness.com
